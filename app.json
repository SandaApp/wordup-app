{
  "expo": {
    "name": "Sanda's WordUp",
    "slug": "wordup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFF7E6",
      "resizeMode": "contain",
      "image": "./assets/splash.png"
    },
    "assetBundlePatterns": [
      "assets/icon.png",
      "assets/adaptive-icon.png",
      "assets/logo-ui.png",
      "assets/intro-heart.png",
      "assets/intro-sword.png",
      "assets/splash.png",
      "assets/notification-icon.png",
      "src/data/*"
    ],
    "android": {
      "package": "com.davidsanda.wordup",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFF7E6",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_PHONE_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.davidsanda.wordup"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6D3FD1"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "235265aa-b96a-445f-8ecf-e21e57638ba7"
      }
    },
    "privacy": "public",
    "description": "Sanda's WordUp — Daily Scripture. Prayer and Growth. Turning screen time into Scripture time."
  }
}
